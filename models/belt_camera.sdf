<?xml version="1.0"?>
<!--
  Fixed RGB camera looking straight down at the upstream part of the conveyor.
  Finds items before they reach the robot. Publishes /belt_camera/image_raw.
  Position and field of view must match conveyor_layout.BELT_CAMERA*.
  A floor pole beside the belt holds it: the pole stays outside the image, out of the arm's reach
  and clear of the bins. The model origin is the camera position.
-->
<sdf version="1.6">
  <model name="belt_camera">
    <static>true</static>
    <link name="link">
      <pose>0 0 0 0 1.5707963 0</pose>
      <visual name="body">
        <geometry><box><size>0.03 0.09 0.03</size></box></geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Black</name>
          </script>
        </material>
      </visual>
      <sensor type="camera" name="belt_camera">
        <update_rate>10.0</update_rate>
        <camera>
          <horizontal_fov>0.70</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>3.0</far></clip>
        </camera>
        <plugin name="belt_camera_controller" filename="libgazebo_ros_camera.so">
          <camera_name>belt_camera</camera_name>
          <frame_name>belt_camera</frame_name>
        </plugin>
      </sensor>
    </link>
    <link name="mount">
      <collision name="base"><pose>0.30 0 -0.84</pose><geometry><box><size>0.10 0.30 0.02</size></box></geometry></collision>
      <visual name="base"><pose>0.30 0 -0.84</pose><geometry><box><size>0.10 0.30 0.02</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>
      <collision name="pole"><pose>0.30 0 -0.41</pose><geometry><box><size>0.03 0.03 0.88</size></box></geometry></collision>
      <visual name="pole"><pose>0.30 0 -0.41</pose><geometry><box><size>0.03 0.03 0.88</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>
      <collision name="arm"><pose>0.15 0 0.03</pose><geometry><box><size>0.33 0.03 0.03</size></box></geometry></collision>
      <visual name="arm"><pose>0.15 0 0.03</pose><geometry><box><size>0.33 0.03 0.03</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>
    </link>
  </model>
</sdf>
