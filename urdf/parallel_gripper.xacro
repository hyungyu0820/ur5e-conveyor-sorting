<?xml version="1.0"?>
<!--
  Simple two-finger parallel gripper (box geometry) for Gazebo Classic.
  Frame convention (same as tool0): z points out of the flange, fingers close along y.
  Finger joint position: 0.0 = fully open (90 mm gap), 0.04 = fully closed (10 mm gap).
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
             iyy="${m*(x*x+z*z)/12}" iyz="0"
             izz="${m*(x*x+y*y)/12}"/>
  </xacro:macro>

  <xacro:macro name="finger_interface" params="name">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="gripper_finger" params="prefix side y_sign">
    <link name="${prefix}finger_${side}_link">
      <visual>
        <origin xyz="0 0 0.03" rpy="0 0 0"/>
        <geometry><box size="0.02 0.01 0.06"/></geometry>
        <material name="gripper_grey"><color rgba="0.6 0.6 0.6 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.03" rpy="0 0 0"/>
        <geometry><box size="0.02 0.01 0.06"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.03" rpy="0 0 0"/>
        <mass value="0.05"/>
        <xacro:box_inertia m="0.05" x="0.02" y="0.01" z="0.06"/>
      </inertial>
    </link>

    <joint name="${prefix}finger_${side}_joint" type="prismatic">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}finger_${side}_link"/>
      <origin xyz="0 ${y_sign*0.05} 0.03" rpy="0 0 0"/>
      <!-- positive motion moves the finger toward the gripper centre -->
      <axis xyz="0 ${-y_sign} 0"/>
      <limit lower="0.0" upper="0.04" effort="100" velocity="0.1"/>
      <dynamics damping="1.0" friction="0.0"/>
    </joint>

    <gazebo reference="${prefix}finger_${side}_link">
      <mu1>2.0</mu1>
      <mu2>2.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>0.0</maxVel>
      <material>Gazebo/Grey</material>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="parallel_gripper" params="prefix parent">
    <link name="${prefix}gripper_base_link">
      <visual>
        <origin xyz="0 0 0.015" rpy="0 0 0"/>
        <geometry><box size="0.04 0.12 0.03"/></geometry>
        <material name="gripper_dark"><color rgba="0.2 0.2 0.2 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.015" rpy="0 0 0"/>
        <geometry><box size="0.04 0.12 0.03"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.015" rpy="0 0 0"/>
        <mass value="0.3"/>
        <xacro:box_inertia m="0.3" x="0.04" y="0.12" z="0.03"/>
      </inertial>
    </link>

    <joint name="${prefix}gripper_base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}gripper_base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <xacro:gripper_finger prefix="${prefix}" side="left" y_sign="1"/>
    <xacro:gripper_finger prefix="${prefix}" side="right" y_sign="-1"/>

    <!-- TCP between the fingertips, used later as the MoveIt end-effector link -->
    <link name="${prefix}gripper_tcp"/>
    <joint name="${prefix}gripper_tcp_joint" type="fixed">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}gripper_tcp"/>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
    </joint>

    <gazebo reference="${prefix}gripper_base_link">
      <material>Gazebo/DarkGrey</material>
    </gazebo>

    <!-- welds the object between the fingers to the wrist on /grasp/attach (src/grasp_attacher.cpp).
         gripper_base_link is merged into wrist_3_link by Gazebo, so that is the palm link. -->
    <gazebo>
      <plugin name="grasp_attacher" filename="libur_grasp_attacher.so">
        <palm_link>${prefix}wrist_3_link</palm_link>
        <finger_link>${prefix}finger_left_link</finger_link>
        <finger_link>${prefix}finger_right_link</finger_link>
        <max_distance>0.05</max_distance>
      </plugin>
    </gazebo>

    <!-- picked up by the same gazebo_ros2_control plugin as the arm -->
    <ros2_control name="${prefix}GripperSystem" type="system">
      <hardware>
        <plugin>gazebo_ros2_control/GazeboSystem</plugin>
      </hardware>
      <xacro:finger_interface name="${prefix}finger_left_joint"/>
      <xacro:finger_interface name="${prefix}finger_right_joint"/>
    </ros2_control>
  </xacro:macro>

</robot>
